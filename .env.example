# Токен от @BotFather
BOT_TOKEN=123456789:AAAA-замените-на-свой-токен
# Ваш chat_id (бот отвечает только на него)
ADMIN_CHAT_ID=123456789

# Интервал проверки: случайный, от MIN до MAX минут
CHECK_INTERVAL_MIN=20
CHECK_INTERVAL_MAX=30

# Регион API (RU-MOW отдаёт Москву и часть области) и фильтр по началу адреса
REGION_ISO=RU-MOW
CITY_PREFIX=Москва

# /log: прирост, после которого считаем, что приехал новый кейс
CASE_THRESHOLD=50
# Присылать тихое уведомление, когда товар в магазине закончился
NOTIFY_SOLD_OUT=true
# Сколько часов показывать последние поставки в /check и /status (0 — не показывать)
RECENT_HOURS=24

DB_PATH=data/hotwheels.db
LOG_LEVEL=INFO

# --- Ашан ---
AUCHAN_ENABLED=true
# Коды магазинов Ашана, которые не проверять (через запятую). 009 — «Европарк» (похоже на склад доставки)
AUCHAN_EXCLUDE=009
# Уведомлять о росте остатка в Ашане начиная с этого прироста (1 — о любом)
AUCHAN_MIN_INCREASE=1
